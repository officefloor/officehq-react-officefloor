diff --git a/src/main/resources/db/migration/V25__projects_client_status_archived_index.sql b/src/main/resources/db/migration/V25__projects_client_status_archived_index.sql
new file mode 100644
index 0000000..8b5b15f
--- /dev/null
+++ b/src/main/resources/db/migration/V25__projects_client_status_archived_index.sql
@@ -0,0 +1,3 @@
+-- A client's page now lists their ACTIVE, non-archived projects by default. Index the columns that
+-- lookup filters by so the default view stays cheap as a client accrues finished/archived work.
+CREATE INDEX idx_projects_client_status_archived ON projects (client_id, status, archived);
