+/** A reusable label a user puts on projects to group them. Mapped to the {@code tags} table (V20). */
+@Entity
+@Table(name = "tags")
+public class Tag {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
