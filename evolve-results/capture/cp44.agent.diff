diff --git a/src/main/resources/db/migration/V24__clients_email_unique.sql b/src/main/resources/db/migration/V24__clients_email_unique.sql
new file mode 100644
index 0000000..fa60339
--- /dev/null
+++ b/src/main/resources/db/migration/V24__clients_email_unique.sql
@@ -0,0 +1,4 @@
+-- Two clients cannot share an email. Enforce uniqueness at the database as the last line of
+-- defence, matching the UI/server rule (the server rejects a duplicate before it reaches here).
+ALTER TABLE clients
+    ADD CONSTRAINT clients_email_unique UNIQUE (email);
