-        Contact saved = contacts.save(new Contact(id, newContact.getName(), newContact.getEmail(),
+        String email = newContact.getEmail();
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) {
+            throw new HttpException(HttpStatus.BAD_REQUEST, "A proper email address is required");
+        }
+        Contact saved = contacts.save(new Contact(id, newContact.getName(), email.trim(),
                 newContact.getRole()));
         response.send(new ContactView(saved.getId(), saved.getClientId(), saved.getName(),
                 saved.getEmail(), saved.getRole()));
diff --git a/src/main/resources/db/migration/V12__contact_email_format.sql b/src/main/resources/db/migration/V12__contact_email_format.sql
new file mode 100644
index 0000000..852f7ef
--- /dev/null
+++ b/src/main/resources/db/migration/V12__contact_email_format.sql
@@ -0,0 +1,7 @@
+-- Every contact needs a proper email: enforce a basic email shape at the schema level so a contact
+-- with a blank or malformed address can never be persisted (defence-in-depth behind the server and
+-- UI validation, mirroring the client check in V2). email is already NOT NULL (V10); this adds the
+-- format check.
+ALTER TABLE contact
+    ADD CONSTRAINT contact_email_format
+    CHECK (REGEXP_LIKE(email, '^[^\s@]+@[^\s@]+\.[^\s@]+$'));
