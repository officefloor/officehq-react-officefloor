+    }
+
+    public BigDecimal getUnitPrice() {
+        return unitPrice;
+    }
+
+    public void setUnitPrice(BigDecimal unitPrice) {
+        this.unitPrice = unitPrice;
+    }
+}
diff --git a/src/main/resources/db/migration/V17__line_items.sql b/src/main/resources/db/migration/V17__line_items.sql
new file mode 100644
index 0000000..37be638
--- /dev/null
+++ b/src/main/resources/db/migration/V17__line_items.sql
@@ -0,0 +1,12 @@
+-- An invoice is now itemised: instead of typing one figure, you list the things you are charging
+-- for. Each line item belongs to one invoice and carries a description, a quantity and the price
+-- for a single unit. The invoice's amount is the sum of each line's quantity times unit price.
+CREATE TABLE line_items (
+    id          BIGINT         GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    invoice_id  BIGINT         NOT NULL REFERENCES invoices(id),
+    description VARCHAR(255)   NOT NULL,
+    qty         INTEGER        NOT NULL,
+    unit_price  NUMERIC(12, 2) NOT NULL
+);
+
+CREATE INDEX idx_line_items_invoice_id ON line_items(invoice_id);
diff --git a/src/main/resources/db/migration/V18__invoice_amount_derived.sql b/src/main/resources/db/migration/V18__invoice_amount_derived.sql
new file mode 100644
index 0000000..84ca381
--- /dev/null
+++ b/src/main/resources/db/migration/V18__invoice_amount_derived.sql
@@ -0,0 +1,6 @@
+-- An invoice's amount is now DERIVED: it is the sum of its line items (quantity times unit price).
+-- A newly raised invoice with no line items yet is worth $0.00, so the old "amount strictly
+-- positive" invariant no longer holds. Drop that check; the amount column now caches the derived
+-- total and is kept in step whenever a line item is added.
+ALTER TABLE invoices DROP CONSTRAINT chk_invoices_amount_positive;
+ALTER TABLE invoices ALTER COLUMN amount SET DEFAULT 0;
