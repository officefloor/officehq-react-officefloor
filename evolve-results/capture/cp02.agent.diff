diff --git a/src/main/resources/db/migration/V2__client_email_required.sql b/src/main/resources/db/migration/V2__client_email_required.sql
new file mode 100644
index 0000000..e7280ae
--- /dev/null
+++ b/src/main/resources/db/migration/V2__client_email_required.sql
@@ -0,0 +1,5 @@
+-- Every client needs a proper email address: enforce it in the schema too, so a bad address can
+-- never be persisted regardless of entry point. Mirrors the front-end and service guards.
+ALTER TABLE clients
+    ADD CONSTRAINT clients_email_format
+    CHECK (REGEXP_LIKE(email, '^[^\s@]+@[^\s@]+\.[^\s@]+$'));
