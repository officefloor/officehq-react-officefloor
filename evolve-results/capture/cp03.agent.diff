diff --git a/src/main/resources/db/migration/V3__projects.sql b/src/main/resources/db/migration/V3__projects.sql
new file mode 100644
index 0000000..b761723
--- /dev/null
+++ b/src/main/resources/db/migration/V3__projects.sql
@@ -0,0 +1,7 @@
+-- Projects: work the owner does for a client. Each project belongs to exactly one client
+-- (client_id FK). Additive: a new versioned migration alongside the clients tables.
+CREATE TABLE projects (
+    id        BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    name      VARCHAR(255) NOT NULL,
+    client_id BIGINT NOT NULL REFERENCES clients(id)
+);
